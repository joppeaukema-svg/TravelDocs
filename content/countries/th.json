    },
    {
      "id": "th-myanmar-border",
      "country": "TH",
      "topic": "safety",
      "title": "Myanmar border strip (10 km) is orange",
      "body": "Except the towns of Mae Sai, Mae Sot and Ranong. Armed drug and people smugglers are active near the Thailand–Laos–Myanmar tri-border (Golden Triangle). The Mae Sai and Mae Sot crossings are open only to Thai and Myanmar passports; don't cross into Myanmar.",
      "severity": "critical",
      "sources": [
        {
          "title": "Reisadvies Thailand — NederlandWereldwijd",
          "url": "https://www.nederlandwereldwijd.nl/reisadvies/thailand"
        }
      ],
      "verifiedAt": "2026-09-30"
    },
    {
      "id": "th-south",
      "country": "TH",
      "topic": "safety",
      "title": "Deep south is orange",
      "body": "Yala, Narathiwat, Pattani and the Songkhla districts Chana, Nathawi, Thepha and Saba Yoi: insurgent attacks, emergency rule in most districts.",
      "severity": "important",
      "sources": [
        {
          "title": "Reisadvies Thailand — NederlandWereldwijd",
