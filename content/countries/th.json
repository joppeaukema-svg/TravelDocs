      "id": "th-visa-free",
      "country": "TH",
      "topic": "entry",
      "title": "Visa-free: 30 days (arrivals from 15 Sep 2026)",
      "body": "Tourists only. Your arrival stamp shows your leave-by date. You must be able to prove you'll leave within the period (e.g. an onward ticket). Repeated short visa-free visits can get you refused; visa runs are allowed at most twice a year.",
      "severity": "important",
      "sources": [
        {
          "title": "Reisadvies Thailand — NederlandWereldwijd",
          "url": "https://www.nederlandwereldwijd.nl/reisadvies/thailand"
        }
      ],
      "verifiedAt": "2026-09-30"
    },
