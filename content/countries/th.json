      "country": "TH",
      "topic": "entry",
      "title": "Passport ≥6 months on arrival, undamaged",
      "body": "At least 6 months valid on arrival. A damaged passport can be refused.",
      "severity": "important",
      "sources": [
        {
          "title": "Reisadvies Thailand — NederlandWereldwijd",
